<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.vpnrouter.daemon</string>
    <key>BundleProgram</key><string>Contents/MacOS/VPNRouterDaemon</string>
    <key>MachServices</key>
    <dict><key>com.vpnrouter.daemon</key><true/></dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ProcessType</key><string>Interactive</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>VPNROUTER_ALLOWED_CLIENT_ID</key><string>com.vpnrouter.app</string>
        <key>VPNROUTER_TEAM_ID</key><string></string>
        <key>VPNROUTER_CERT_SHA1</key><string></string>
        <key>VPNROUTER_ALLOW_UNSIGNED</key><string>0</string>
    </dict>
</dict>
</plist>
